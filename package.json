{
  "name": "@moritzbrantner/layer-editor",
  "version": "0.2.1",
  "private": false,
  "homepage": "https://github.com/moritzbrantner/layer-editor#readme",
  "bugs": {
    "url": "https://github.com/moritzbrantner/layer-editor/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/layer-editor.git"
  },
  "files": [
    "dist",
    "styles.css",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js"
    },
    "./serialization": {
      "types": "./dist/serialization.d.ts",
      "import": "./dist/serialization.js"
    },
    "./styles.css": "./styles.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup src/index.ts src/core.ts src/react.tsx src/history.ts src/serialization.ts --format esm --dts --clean --out-dir dist",
    "examples:build": "vite build --config examples/vite.config.ts",
    "examples:dev": "vite --config examples/vite.config.ts --host 0.0.0.0",
    "examples:preview": "vite preview --config examples/vite.config.ts --host 0.0.0.0",
    "dev:source": "bun run source:prepare && bun run examples:dev",
    "source:prepare": "node scripts/source-deps.mjs prepare",
    "source:status": "node scripts/source-deps.mjs status",
    "source:smoke": "node scripts/source-deps.mjs smoke",
    "source:restore": "node scripts/source-deps.mjs restore",
    "format": "oxfmt README.md package.json tsconfig.base.json tsconfig.json vitest.config.ts styles.css src examples scripts docs",
    "format:check": "oxfmt --check README.md package.json tsconfig.base.json tsconfig.json vitest.config.ts styles.css src examples scripts docs",
    "lint": "oxlint src examples --format=github",
    "prepack": "bun run build",
    "check-types": "tsc --noEmit && tsc --noEmit -p examples/tsconfig.json",
    "test": "vitest run",
    "pack:dry": "npm pack --dry-run --ignore-scripts --json",
    "test:package": "bun run build && bun run pack:dry && node scripts/verify-package.mjs",
    "bench": "mkdir -p benchmark-results && vitest bench --run --outputJson benchmark-results/vitest-bench.json",
    "verify:checks": "bun run format:check && bun run lint && bun run check-types && bun run test && bun run build && bun run test:package && bun run examples:build",
    "verify:source": "bun run source:prepare && bun run source:smoke && bun run format:check && bun run lint && bun run check-types && bun run test && bun run build && bun run examples:build",
    "verify:registry": "bun run source:restore && bun run verify:checks",
    "verify": "bun run verify:registry"
  },
  "dependencies": {
    "@moenarch/editor-core": "git+https://github.com/moritzbrantner/editor-core.git#51463abfcafc9f6173f19320316b5161e86b5fbd",
    "@moritzbrantner/ui": "^0.10.0",
    "lucide-react": "^1.17.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.4",
    "@testing-library/react": "16.3.3",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "29.1.1",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "bun@1.4.3",
  "trustedDependencies": [
    "@moenarch/editor-core"
  ]
}
