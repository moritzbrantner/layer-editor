{
  "name": "@moritzbrantner/layer-editor",
  "version": "0.1.0",
  "private": false,
  "homepage": "https://github.com/moritzbrantner/layer-editor#readme",
  "bugs": {
    "url": "https://github.com/moritzbrantner/layer-editor/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/layer-editor.git"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js"
    },
    "./serialization": {
      "types": "./dist/serialization.d.ts",
      "import": "./dist/serialization.js"
    },
    "./styles.css": "./styles.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup src/index.ts src/core.ts src/react.tsx src/history.ts src/serialization.ts --format esm --dts --clean --out-dir dist",
    "examples:build": "vite build --config examples/vite.config.ts",
    "examples:dev": "vite --config examples/vite.config.ts --host 0.0.0.0",
    "examples:preview": "vite preview --config examples/vite.config.ts --host 0.0.0.0",
    "format": "oxfmt README.md package.json tsconfig.base.json tsconfig.json vitest.config.ts styles.css src examples scripts",
    "format:check": "oxfmt --check README.md package.json tsconfig.base.json tsconfig.json vitest.config.ts styles.css src examples scripts",
    "lint": "oxlint src examples --format=github",
    "prepack": "bun run build",
    "check-types": "tsc --noEmit && tsc --noEmit -p examples/tsconfig.json",
    "test": "vitest run",
    "pack:dry": "npm pack --dry-run --ignore-scripts --json",
    "test:package": "bun run build && bun run pack:dry && node scripts/verify-package.mjs",
    "bench": "mkdir -p benchmark-results && vitest bench --run --outputJson benchmark-results/vitest-bench.json",
    "verify": "bun run format:check && bun run lint && bun run check-types && bun run test && bun run build && bun run test:package && bun run examples:build"
  },
  "dependencies": {
    "@moritzbrantner/editor-core": "^0.1.0",
    "@moritzbrantner/ui": "^0.9.1",
    "lucide-react": "^1.17.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "4.1.7",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "packageManager": "bun@1.3.14"
}
